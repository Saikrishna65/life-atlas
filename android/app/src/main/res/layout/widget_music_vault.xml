<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Dynamic Theme Background (renders dynamic theme gradient + rounded corners + border) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Album Cover Artwork with Sonic Ring Glow -->
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <!-- Animated Equalizer Rhythm Waveform Indicator -->
    <ImageView
        android:id="@+id/widget_visualizer"
        android:layout_width="48dp"
        android:layout_height="18dp"
        android:layout_toEndOf="@id/widget_artwork"
        android:layout_alignParentTop="true"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <!-- Spacious Minimal Playback Controls -->
    <LinearLayout
        android:id="@+id/widget_controls_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_artwork"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="Previous Track" />

        <!-- Play / Pause Button -->
        <ImageButton
            android:id="@+id/widget_btn_play"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="Play or Pause" />

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:contentDescription="Next Track" />

    </LinearLayout>

</RelativeLayout>
