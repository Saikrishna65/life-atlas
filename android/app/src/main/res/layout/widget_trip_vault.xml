<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_trip_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Dynamic Theme Background (renders luxury gradient + rounded corners + status-colored glow border) -->
    <ImageView
        android:id="@+id/widget_trip_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Top Row: Icon + Category Tag + Live Status Badge -->
    <LinearLayout
        android:id="@+id/widget_trip_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_trip_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧭 ATLAS EXPEDITION"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/widget_trip_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2038BDF8"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="ON THE ROAD"
            android:textColor="#BAE6FD"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Center Section: Title & Subtitle / Current Leg & 2 Metrics -->
    <LinearLayout
        android:id="@+id/widget_trip_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_trip_header"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_trip_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Himalayan Ridge Expedition"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_trip_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Leg 3: Devprayag to Chopta Meadows"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 2-Column Telemetry / Metric Stats -->
        <LinearLayout
            android:id="@+id/widget_trip_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_trip_metric1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/widget_trip_metric1_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="436.1 km"
                    android:textColor="#38BDF8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_trip_metric2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALTITUDE"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/widget_trip_metric2_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="2,680 m"
                    android:textColor="#FBBF24"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:id="@+id/widget_trip_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_trip_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 Next: Chopta Base Camp"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_trip_btn_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2038BDF8"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Live Map →"
            android:textColor="#7DD3FC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_trip_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="#15FFFFFF"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Open Vault"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>

